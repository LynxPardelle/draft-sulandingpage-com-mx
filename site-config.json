    },
    "seo": {
      "siteName": "Sulandingpage",
      "title": "Sulandingpage | Landing pages claras para Google Ads",
      "description": "Landing pages rapidas, claras y medibles para negocios que quieren convertir trafico en conversaciones y leads.",
      "canonicalOrigin": "https://sulandingpage.com.mx",
      "enforceCanonicalHost": true,
      "forceHttps": true,
      "defaultImage": "https://sulandingpage.com.mx/assets/og-1200x630.svg",
